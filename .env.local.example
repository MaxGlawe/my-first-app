# Supabase (Required)
# Zu finden in: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://dein-projekt-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# Site URL (used for redirects in auth flows)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Anthropic Claude API (Required for PROJ-6: KI-Arztbericht-Generator)
# Zu finden in: https://console.anthropic.com/ → API Keys
# WICHTIG: Diesen Key NIEMALS mit NEXT_PUBLIC_ prefixen — er darf nicht im Browser-Bundle landen!
ANTHROPIC_API_KEY=sk-ant-dein-api-key-hier

# Buchungstool-Integration (PROJ-7)
# Webhook-Secret für HMAC-SHA256 Signaturprüfung eingehender Webhook-Events.
# Initial-Secret: beliebiger langer zufälliger String (mind. 32 Zeichen).
# Kann danach über /os/admin/integrations → "Neues Secret generieren" rotiert werden.
# WICHTIG: Niemals mit NEXT_PUBLIC_ prefixen!
BOOKING_WEBHOOK_SECRET=dein-geheimes-webhook-secret-min-32-zeichen

# URL des Buchungstools (Optional — wird für "Termin buchen" Button verwendet)
# Beispiel: https://buchung.deine-praxis.de
NEXT_PUBLIC_BOOKING_TOOL_URL=https://buchung.deine-praxis.de

# PWA-Setup & Push-Notifications (PROJ-14)
# VAPID-Keys für Web Push. Generieren mit:
#   node -e "const webpush = require('web-push'); const keys = webpush.generateVAPIDKeys(); console.log(keys);"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY ist sicher für den Browser — wird für PushManager.subscribe() benötigt
# VAPID_PRIVATE_KEY und VAPID_SUBJECT NUR server-seitig (ohne NEXT_PUBLIC_)!
NEXT_PUBLIC_VAPID_PUBLIC_KEY=dein-vapid-public-key-base64url
VAPID_PRIVATE_KEY=dein-vapid-private-key-base64url
VAPID_SUBJECT=mailto:praxis@example.com

# Cron-Secret: Zufälliger langer String (mind. 32 Zeichen)
# Supabase pg_cron sendet diesen im Header "x-cron-secret" — API-Route prüft ihn
# WICHTIG: Niemals mit NEXT_PUBLIC_ prefixen!
CRON_SECRET=dein-geheimes-cron-secret-min-32-zeichen

# PROJ-19: Interne API-Authentifizierung (Externe Käufer-Accounts)
# Gemeinsames Secret für server-interne API-Aufrufe (z.B. Buyer-Account-Erstellung,
# Upgrade-Trigger vom Booking-Webhook). Zufälliger langer String (mind. 32 Zeichen).
# Niemals mit NEXT_PUBLIC_ prefixen!
INTERNAL_API_SECRET=dein-internes-api-secret-min-32-zeichen

# Öffentliche Booking-URL für den "Video-Analyse buchen"-Button im Käufer-Dashboard
# Zeigt auf die Praxis-OS-Website oder direkt auf das externe Buchungstool.
NEXT_PUBLIC_BOOKING_URL=https://wwwpraxis-os.com/online-physiotherapie

# ElevenLabs TTS (PROJ-17: Sprachausgabe für Übungen, Kurse & Trainingspläne)
# API-Key: Zu finden in https://elevenlabs.io → Profile → API Keys
# Voice-ID: https://elevenlabs.io/voice-library (eine deutsche Stimme wählen)
# WICHTIG: Niemals mit NEXT_PUBLIC_ prefixen — darf nicht im Browser-Bundle landen!
ELEVENLABS_API_KEY=sk_your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here
# Optional: Model ID (Standard: eleven_multilingual_v2)
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# PROJ-23: Schmerzcheck-Funnel (Landing + Lead-Capture)
# Signatur-Secret für Lead-Access-/Double-Opt-in-Tokens (HS256).
# Zufälliger langer String (mind. 32 Zeichen). Niemals mit NEXT_PUBLIC_ prefixen!
# Erzeugen z.B. mit:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
LEAD_LINK_SECRET=dein-lead-link-secret-min-32-zeichen

# Schmerzcheck-Mailer (SMTP über das SiteGround-Postfach info@physiotherapie-glawe.de)
# Daten in SiteGround → Site Tools → E-Mail → Konten. Port 465 (SSL) oder 587 (STARTTLS).
# WICHTIG: Eigene Vars (nicht die SMTP_* der Praxis-GMX-Mails), damit der Funnel
# einen eigenen, markenkonformen Absender hat. Niemals mit NEXT_PUBLIC_ prefixen!
SCHMERZCHECK_SMTP_HOST=mail.physiotherapie-glawe.de
SCHMERZCHECK_SMTP_PORT=587
SCHMERZCHECK_SMTP_USER=info@physiotherapie-glawe.de
SCHMERZCHECK_SMTP_PASS=dein-postfach-passwort
SCHMERZCHECK_SMTP_FROM_NAME=Max Glawe · Praxis OS
SCHMERZCHECK_SMTP_FROM_EMAIL=info@physiotherapie-glawe.de

# Hinweis: Für die spätere Marketing-Drip-Strecke (Phase 4, D1–D4) ist ein
# echter ESP (z.B. Brevo Free-Tier 300/Tag oder Resend) empfohlen — Massen-/
# Marketingversand über das SiteGround-Postfach ist deliverability-/AGB-riskant.

# Meta Pixel + Conversions API (Tracking für Paid-Ads)
# Pixel-ID darf im Browser landen → NEXT_PUBLIC_. CAPI-Token NUR server-seitig!
NEXT_PUBLIC_META_PIXEL_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
# Nur während des Testens setzen (Meta Events Manager → Test Events). In Produktion leer lassen!
META_CAPI_TEST_EVENT_CODE=
