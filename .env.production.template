# ====================================================
# Praxis OS — Production Environment Variables
# ====================================================
# Kopiere diese Datei auf den Server als .env.production.local
# und fülle die Werte aus.
#
# WICHTIG: Diese Datei NIEMALS in Git committen!
# ====================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Site URL — MUSS eure Production-Domain sein (ohne trailing slash)
NEXT_PUBLIC_SITE_URL=https://DEINE-DOMAIN.de

# Anthropic API Key (für KI-Arztbericht-Generator)
ANTHROPIC_API_KEY=sk-ant-api03-DEIN-KEY-HIER

# Buchungstool
BOOKING_WEBHOOK_SECRET=your-webhook-secret-here
NEXT_PUBLIC_BOOKING_TOOL_URL=https://DEINE-DOMAIN.de

# Node Environment
NODE_ENV=production

# SMTP (E-Mail-Versand)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password-here
EMAIL_FROM_NAME=Praxis OS

# Stripe (Zahlungen)
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here
STRIPE_PRICE_MONTHLY=price_your-monthly-price-id
STRIPE_PRICE_YEARLY=price_your-yearly-price-id

# Cron-Secret
CRON_SECRET=your-cron-secret-here

# VAPID (Web Push Notifications)
VAPID_PRIVATE_KEY=your-vapid-private-key-here
VAPID_SUBJECT=mailto:your-email@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# ElevenLabs TTS
ELEVENLABS_API_KEY=sk_your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=your-voice-id-here
